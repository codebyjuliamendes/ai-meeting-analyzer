{
  "openapi": "3.0.0",
  "info": {
    "title": "NexusMeet API",
    "description": "API documentation for NexusMeet AI Meeting Analyzer",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4003",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/stream-meeting": {
      "get": {
        "summary": "Stream Meeting Transcript Analysis",
        "description": "SSE Endpoint for streaming meeting transcripts with sentiment analysis and action items.",
        "responses": {
          "200": {
            "description": "A Server-Sent Events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
