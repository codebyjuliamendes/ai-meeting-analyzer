# Server
PORT=4003
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Express "trust proxy" (false | true | number of hops | comma-separated subnets). Set when behind a reverse proxy
# so rate limiting sees the real client IP.
TRUST_PROXY=false

# AI provider: auto (anthropic when ANTHROPIC_API_KEY is set, otherwise demo) | anthropic | demo
AI_PROVIDER=auto
# Never commit a real key. Transcripts are sent to Anthropic when this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# default = server-side refusal fallback (beta) | off
ANTHROPIC_FALLBACKS=default
# Per-attempt timeout and SDK retries (429/5xx/connection errors)
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Limits
ANALYZE_RATE_LIMIT_PER_MIN=10
MAX_TRANSCRIPT_CHARS=60000
MAX_CONCURRENT_STREAMS=50

# Live demo replay pacing
STREAM_STEP_MS=2500
STREAM_JITTER_MS=2000

SHUTDOWN_TIMEOUT_MS=10000
ENABLE_API_DOCS=true
